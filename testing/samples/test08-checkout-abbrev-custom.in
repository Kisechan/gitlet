# Test checkout with abbreviated commit ID
I definitions.inc
> init
<<<
+ wug.txt wug.txt
> add wug.txt
<<<
> commit "version 1"
<<<
+ wug.txt notwug.txt
> add wug.txt
<<<
> commit "version 2"
<<<
> log
===
${COMMIT_HEAD}
version 2

===
${COMMIT_HEAD}
version 1

===
${COMMIT_HEAD}
initial commit

<<<*
D COMMIT1_SHORT "${2}"
# Checkout using abbreviated commit ID (first 8 chars)
> checkout ${COMMIT1_SHORT} -- wug.txt
<<<
= wug.txt wug.txt
